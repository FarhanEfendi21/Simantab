	Dim kvs As KeyValueStore
	
	Public isDevelopment As Boolean = True
	Public const latMerapi As Float =  -7.540431003854707
	Public const lonMerapi As Float = 110.44620420034246
	
	Public const rdcLink As String = "http://simantab.slemankab.go.id:17183/rdc"
	Public const rdcEmail As String = "http://simantab.slemankab.go.id:17183/email"
	Public const urlUpload As String = "http://simantab.slemankab.go.id/uploads/upl.php"

'	Public const rdcLink As String = "http://192.168.40.10:17183/rdc"
'	Public const rdcEmail As String = "http://192.168.40.10:17183/email"
'	Public const urlUpload As String = "http://192.168.40.10/app/uploads/upl.php"
	Type resJrdc (success As Boolean, res As DBResult, errMsg As String)
	Public const kunci As String = "2eTC@$7JwC@sfkU=Wsk"
	
	' Konfigurasi Ollama VPS SIGUMI.
	Public const ollamaLink As String = "https://ollama-mvod.srv1985398.hstgr.cloud"
