End Sub



Sub Globals
	'These global variables will be redeclared each time the activity is created.
	Dim vp As AHViewPager
	Dim vpPanels(3) As Panel
	Dim ToolBar As ACToolBarDark
	Private ABHelper As ACActionBar
	Dim container As AHPageContainer
	Private xui As XUI
		
	Dim mLogin As CLLogin
	Dim mResetPassword As CLResetPassword
	Dim mRegister As CLRegister
	Dim rp As RuntimePermissions
	Private ImageView1 As ImageView
	Dim altitude As Float
	Dim gps1 As GPS
End Sub

Sub Activity_Create(FirstTime As Boolean)
	Dim rp As RuntimePermissions
	rp.CheckAndRequest("android.permission.ACCESS_FINE_LOCATION")
	Wait For Activity_PermissionResult (Permission As String, Result As Boolean)
	
	If FirstTime Then
		ShowSplash
	Else
		Activity.LoadLayout("Laypilih")
	End If
	
	kvs.Initialize(xui.DefaultFolder,"kvs")
	
	ToolBar.Initialize("Toolbar")
	ToolBar.SetAsActionBar
	ABHelper.Initialize
	ABHelper.ShowUpIndicator=False
'	ToolBar.Title= titleAPP
'	ToolBar.SubTitle= translate(1)
'	Activity.AddView(ToolBar,0,0,100%X,56dip)

	gps1.Initialize("GPS")
	gps1.Start(0, 0)

	
	Activity.Color = Colors.White
	ToolBar.InitMenuListener
	InitVP0
'	mLogin.Initialize(vpPanels(0))
'	mLogin.createLayout
End Sub

private Sub ShowSplash
	Activity.LoadLayout("LaySplash")
	Sleep(1000)
	Activity.RemoveAllViews
	InitVP0
'	Activity.LoadLayout("laypilih")
	vpPanels(0).RemoveAllViews
	vpPanels(0).LoadLayout("laypilih")
End Sub

Sub Activity_Resume
	Dim api1 As Api
	api1.Initialize
'	If kvs.Contains("iduser")
	Try
	If kvs.GetEncrypted("iduser", kunci) <> Null  Then
		If IsNumber(kvs.GetEncrypted("iduser", kunci))  Then
			StartActivity(ActHome)
			Activity.Finish
		End If
	End If
	Catch
	End Try

End Sub

Sub Activity_Pause (UserClosed As Boolean)

End Sub

Private Sub ShouldCloseActivity
	Dim sf As Object = Msgbox2Async("Keluar?","","ya","Tidak","",Null,False)
	Wait For (sf) Msgbox_Result (Result As Int)
	If Result = -1  Then
		Activity.Finish
	End If
End Sub

Sub Activity_KeyPress (KeyCode As Int) As Boolean 'Return True to consume the event
	If KeyCode = KeyCodes.KEYCODE_BACK Then
		Toolbar_NavigationItemClick
		Return True
	End If
	Return False
End Sub

Sub Toolbar_NavigationItemClick
	If vp.CurrentPage = 0 Then
		ShouldCloseActivity
	Else
		vp.GotoPage(vp.CurrentPage - 1, True)
	End If
End Sub

Sub InitVP0
	container.Initialize
	For i = 0 To vpPanels.Length-1
		vpPanels(i).Initialize("")
		container.AddPage(vpPanels(i),"")
	Next
		
	vp.Initialize2(container, "vp")
	
	Dim TabsHeight As Int=0

	Activity.AddView(vp, 0, ToolBar.Height+TabsHeight, Activity.Width, Activity.Height-ToolBar.Height-TabsHeight)
	vp.PagingEnabled=False
	vp.OffscreenPageLimit=4
	vp.CurrentPage=0
	
End Sub


Public Sub gotoResetPassword
	vpPanels(1).RemoveAllViews
	mResetPassword.Initialize(vpPanels(1))
	mResetPassword.createLayout
	vp.GotoPage(1,True)
End Sub

Public Sub gotoRegister(hp As String)
	vpPanels(1).RemoveAllViews
	mRegister.Initialize(vpPanels(1))
	mRegister.createLayout(hp)
	vp.GotoPage(1,True)
End Sub

Public Sub successLogin
	StartActivity(ActHome)
	Activity.Finish
End Sub

Public Sub gotoLogin(hp As String)
	vpPanels(1).RemoveAllViews
	mLogin.Initialize(vpPanels(1))
	mLogin.createLayout
	mLogin.inputHPRegster(hp)
	vp.GotoPage(1,True)
End Sub


Private Sub Button1_Click
	gotoLogin("")
End Sub

Private Sub Button2_Click
	gotoRegister("")
End Sub
